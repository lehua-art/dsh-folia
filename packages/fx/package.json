{
  "name": "dsh-plugin-folia-fx",
  "version": "0.1.0",
  "description": "Click & trail effects for the DSH wallpaper engine: a canvas layer that draws pointer clicks and trails above the wallpaper, plus its Extension-tab settings island.",
  "icon": "./icon.png",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.fx.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "locale/",
    "icon.png",
    "package.json"
  ],
  "license": "MIT"
}
