{
  "name": "dsh-folia",
  "version": "1.5.1",
  "description": "Folia 壁纸引擎：在 dsh-plugin-wallpaper-engine（MIT, elysia395）基础上增加自建站点数据源",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "dsh": "^0.2.0-rc.1"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "icon": "./icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lehua-art/dsh-folia.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "wallpaper-engine",
    "wallpaper",
    "webwallgl"
  ],
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./subpackage-boot.js": "./lib/subpackage-boot.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "icon.png",
    "LICENSE",
    "README.md",
    "README.beginner.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.5-rc.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "dependencies": {
    "webwallgl": "^3.0.0",
    "x11": "^4.3.1",
    "dsh-plugin-wallpaper-engine-about-notice": "1.4.0",
    "dsh-plugin-wallpaper-engine-fonts": "1.4.0",
    "dsh-plugin-wallpaper-engine-fx": "1.4.0",
    "dsh-plugin-wallpaper-engine-mascot-avatar": "1.4.0",
    "dsh-plugin-wallpaper-engine-media-bridge": "1.4.0",
    "dsh-plugin-wallpaper-engine-parallax": "1.4.0",
    "dsh-plugin-wallpaper-engine-pet-link": "1.4.0",
    "dsh-folia-host": "1.5.1"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  },
  "author": "lehua-art (fork of dsh-plugin-wallpaper-engine by elysia395)",
  "homepage": "https://github.com/lehua-art/dsh-folia",
  "bugs": {
    "url": "https://github.com/lehua-art/dsh-folia/issues"
  }
}
