                  "lib/media/frame-store.js",
                  "lib/media/media-dirs.js",
                  "lib/media-origin.js",
                  "lib/inventory.js",
                  "lib/serve.js",
                  "lib/faststart.js",
                  "lib/cache-dir.js",
                  "lib/upload-store.js",
                  "lib/diag-trace.js",
                  "lib/http-lifecycle.js",
                  "lib/mp4-vfs.js",
                  "lib/startup-sweep.js",
                  "lib/fs-paths.js",
                  "lib/upload-dir.js",
                  "lib/wallpaper-scan.js",
                  "lib/steam-discovery.js",
                  "lib/webwallgl/",
                  "lib/we-assets.js",
                  "lib/shim-seed.js",
                  "lib/we-props.js",
                  "lib/we-focus-guard.js",
                  "lib/types/index.d.ts",
                  "lib/types/client.d.ts",
