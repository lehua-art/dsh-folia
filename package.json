                  "README.beginner.md",
                  "lib/components/"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "inject":  [
                                              "@deepseek-ai/dsh-client-runtime"
                                          ],
                               "platform":  "web",
                               "immediately":  true
                           }
            },
    "license":  "MIT",
    "scripts":  {
                    "build":  "node scripts/build-client.mjs",
                    "install:source":  "node scripts/install-source.mjs",
                    "install:release":  "node scripts/install-release.mjs",
                    "pack:release":  "node scripts/pack-release.mjs",
                    "verify:deployment":  "node test/verify-deployment.mjs",
                    "verify:pet-link":  "node test/verify-pet-link.mjs",
                    "verify:pet-link:integration":  "node test/verify-pet-hotplug-integration.mjs",
                    "verify:pet-link:browser":  "node test/verify-pet-tuner-browser.mjs",
                    "verify":  "node test/run-guards.mjs verify",
                    "verify:docs":  "node test/run-guards.mjs docs",
                    "verify:bridge":  "node test/verify-bridge-ci.mjs --provision",
                    "verify:bridge:strict":  "node test/verify-media-bridge.mjs --provision",
                    "verify:e2e":  "node test/e2e-web-media-origin.mjs",
                    "lint":  "eslint .",
                    "typecheck":  "tsc --noEmit -p tsconfig.json",
                    "verify:static":  "node test/verify-static.mjs",
                    "smoke":  "node test/run-guards.mjs smoke",
                    "verify:all":  "node test/run-guards.mjs all",
                    "prepack":  "node scripts/prepare.mjs"
                },
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "^4.0.4",
                             "@deepseek-ai/dsh-client-runtime":  "\u003e=0.1.5-rc.1",
                             "@deepseek-ai/dsh-client-ui-slots":  "\u003e=0.1.5-rc.1",
                             "@deepseek-ai/dsh-host-webserver":  "\u003e=0.1.5-rc.1",
                             "react":  "^18.2.0"
                         },
    "peerDependenciesMeta":  {
                                 "@deepseek-ai/dsh-client-runtime":  {
                                                                         "optional":  true
                                                                     },
                                 "@deepseek-ai/dsh-client-ui-slots":  {
                                                                          "optional":  true
                                                                      },
                                 "@deepseek-ai/dsh-host-webserver":  {
                                                                         "optional":  true
                                                                     }
                             },
    "dependencies":  {
                         "webwallgl":  "^3.0.0",
                         "x11":  "^4.3.1"
                     },
    "overrides":  {
                      "js-yaml":  "4.3.2"
                  },
    "devDependencies":  {
                            "@eslint/js":  "^10.0.1",
                            "@types/node":  "^26.6.5",
                            "eslint":  "^10.12.0",
                            "typescript":  "^7.0.2"
                        }
}