{
    "name":  "dsh-folia",
    "version":  "2.3.3",
    "description":  "Folia 壁纸引擎：把本机 Wallpaper Engine 壁纸搬进 DSH 界面（场景实时渲染 / 视频 / 网页），内置液态玻璃与 Folia 吉祥物，并可从自建站点拉取壁纸。单包形态（组件已合并）。",
    "type":  "module",
    "engines":  {
                    "node":  "\u003e=22.12.0",
                    "dsh":  "^0.2.0-rc.1"
                },
    "main":  "lib/index.js",
    "types":  "lib/types/index.d.ts",
    "icon":  "./icon.png",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/lehua-art/dsh-folia.git"
                   },
    "keywords":  [
                     "dsh",
                     "dsh-plugin",
                     "deepseek-harness",
                     "wallpaper",
                     "folia",
                     "theme",
                     "background"
                 ],
    "publishConfig":  {
                          "access":  "public"
                      },
    "exports":  {
                    ".":  {
                              "types":  "./lib/types/index.d.ts",
                              "default":  "./lib/index.js"
                          },
                    "./client":  {
                                     "types":  "./lib/types/client.d.ts",
                                     "default":  "./lib/client.js"
                                 },
                    "./subpackage-boot.js":  "./lib/subpackage-boot.js",
                    "./cordis.patch.yml":  "./cordis.patch.yml",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "icon.png",
                  "lib/index.js",
                  "lib/host-boot.js",
                  "lib/log.js",
                  "lib/notice.js",
                  "lib/kernel/",
